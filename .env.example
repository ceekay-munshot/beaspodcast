# Munshot — local environment. Copy to `.env` (gitignored) and fill in.
#
# LLM PROVIDER — /api/summary needs at least one of the keys below. Claude via
# Amazon Bedrock is the PRIMARY provider whenever BEDROCK_API_KEY is set; OpenAI
# and Anthropic sit behind it as automatic fallbacks. Confirm the wiring in ten
# seconds with:  curl localhost:5173/api/health/llm
#
# For `wrangler pages dev` (rather than `npm run dev`), put these same names in
# a `.dev.vars` file instead — it is already gitignored.

# Amazon Bedrock — the Bedrock API key, used as a bearer token in the x-api-key
# header. No AWS credentials, AWS SDK, or SigV4 signing needed.
BEDROCK_API_KEY=

# Bedrock region. Default us-east-1.
# AWS_BEDROCK_REGION=us-east-1

# Pin ONE Bedrock model instead of walking the built-in fallback chain
# (anthropic.claude-opus-5 → anthropic.claude-opus-4-8 → anthropic.claude-sonnet-5).
# Opus 5 access is granted per AWS account, so a 403 on it is normal — the chain
# then drops to Opus 4.8. Model ids carry the "anthropic." prefix.
# AWS_BEDROCK_MODEL_ID=anthropic.claude-opus-4-8

# Force one provider to the front of the chain: bedrock | openai | anthropic.
# Unset means "Bedrock first when BEDROCK_API_KEY is present". Set to "openai"
# to switch back to OpenAI as primary.
# LLM_PROVIDER=openai

# OpenAI — https://platform.openai.com/api-keys (starts with "sk-")
OPENAI_API_KEY=

# Anthropic direct — https://console.anthropic.com/settings/keys (starts with "sk-ant-")
# ANTHROPIC_API_KEY=

# Optional model override for the OpenAI/Anthropic-direct paths only (Bedrock uses
# AWS_BEDROCK_MODEL_ID). Defaults: OpenAI → gpt-4o-mini, Anthropic → claude-opus-4-8
# SUMMARY_MODEL=gpt-4o-mini

# TRANSCRIPTION (optional) — used only for shows WITHOUT a transcript in their feed.
# Provider chain: feed transcript (free) → Groq (free, short episodes) → Deepgram (any length)

# Deepgram — transcribes long episodes (URL-based, any length). https://console.deepgram.com
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3

# Groq free-tier Whisper (short episodes) — https://console.groq.com/keys (starts with "gsk_")
GROQ_API_KEY=
